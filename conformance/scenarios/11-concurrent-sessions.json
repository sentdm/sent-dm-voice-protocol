{
  "description": "Two sessions on one connection at once: each reply goes to its own session, and the two sessions' replies may arrive in either order.",
  "steps": [
    {
      "send": {
        "type": "session.start",
        "session_id": "$a",
        "call_id": "call_conformance-a",
        "agent_id": "agent_conformance",
        "direction": "inbound",
        "from": { "kind": "number", "value": "+14155550100" },
        "to": { "kind": "number", "value": "+14155550199" },
        "session_type": "text",
        "started_at": "2026-10-23T12:00:00Z"
      }
    },
    { "expect": { "type": "agent.say", "session_id": "$a", "text": "Hello from the conformance agent." } },
    {
      "send": {
        "type": "session.start",
        "session_id": "$b",
        "call_id": "call_conformance-b",
        "agent_id": "agent_conformance",
        "direction": "inbound",
        "from": { "kind": "number", "value": "+14155550100" },
        "to": { "kind": "number", "value": "+14155550199" },
        "session_type": "text",
        "started_at": "2026-10-23T12:00:00Z"
      }
    },
    { "expect": { "type": "agent.say", "session_id": "$b", "text": "Hello from the conformance agent." } },
    { "send": { "type": "user.said", "session_id": "$b", "text": "echo second" } },
    { "send": { "type": "user.said", "session_id": "$a", "text": "echo first" } },
    { "expect": { "type": "agent.say", "session_id": "$a", "text": "first" } },
    { "expect": { "type": "agent.say", "session_id": "$b", "text": "second" } },
    {
      "send": { "type": "session.end", "session_id": "$a", "reason": "caller_hung_up", "duration_ms": 1000 }
    },
    { "send": { "type": "session.end", "session_id": "$b", "reason": "caller_hung_up", "duration_ms": 1000 } }
  ]
}
